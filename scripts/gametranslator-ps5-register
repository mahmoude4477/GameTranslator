#!/bin/bash
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
NODE_BIN="/opt/homebrew/bin/node"
if [ ! -x "$NODE_BIN" ]; then
    NODE_BIN="$(which node)"
fi
if [ -z "$NODE_BIN" ]; then
    echo '{"event":"error","message":"Sistemde Node.js bulunamadı."}'
    exit 1
fi

SCRIPT=""
CANDIDATES=(
    "$DIR/../Resources/ps5-register/ps5-register.js"
    "$DIR/ps5-register.js"
    "/Applications/GameTranslator.app/Contents/Resources/ps5-register/ps5-register.js"
    "/Users/Sefflex/Documents/gametranslator/GameTranslate-main/scripts/ps5-register.js"
)

for c in "${CANDIDATES[@]}"; do
    if [ -f "$c" ]; then
        SCRIPT="$c"
        break
    fi
done

if [ -z "$SCRIPT" ]; then
    echo '{"event":"error","message":"ps5-register.js bulunamadı."}'
    exit 1
fi

exec "$NODE_BIN" "$SCRIPT" "$@"
