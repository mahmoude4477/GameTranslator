<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>GameTranslator</AssemblyName>
    <RootNamespace>GameTranslator.App</RootNamespace>
    <ApplicationIcon>Assets\GameTranslator.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- خطافات التثبيت والتحديث في Velopack يجب أن تعمل قبل بدء WPF (Program.Main). -->
    <StartupObject>GameTranslator.App.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3537.50" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
    <!-- ShellWindow.xaml يقرأ هذا كأيقونة للنافذة؛ أما ApplicationIcon فهو أيقونة ملف exe فقط. -->
    <Resource Include="Assets\GameTranslator.ico" />
  </ItemGroup>

  <!-- حزم تطبيق التلفزيون: ينسخ الحزم الموجودة في dist/tv-app و tv/packages إلى المجلد tv-app/ -->
  <ItemGroup>
    <Content Include="..\..\..\dist\tv-app\*.ipk;..\..\..\dist\tv-app\*.wgt;..\..\..\dist\tv-app\*.apk;..\..\..\tv\packages\*.ipk;..\..\..\tv\packages\*.wgt;..\..\..\tv\packages\*.apk" Link="tv-app\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- أدوات الاقتران التلقائي مع PS5 (Node.js وسكربت playactor) -->
  <ItemGroup>
    <Content Include="..\..\..\scripts\bin\node.exe" Link="helpers\node.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\scripts\ps5-register.js" Link="helpers\ps5-register.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\..\scripts\ps5-register\node_modules\**\*" Link="helpers\ps5-register\node_modules\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- محرك Remote Play المحمول Chiaki -->
  <ItemGroup>
    <Content Include="..\..\..\chiaki\**\*" Link="chiaki\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameTranslator.Core\GameTranslator.Core.csproj" />
    <ProjectReference Include="..\GameTranslator.Translation\GameTranslator.Translation.csproj" />
    <ProjectReference Include="..\GameTranslator.RemotePlay\GameTranslator.RemotePlay.csproj" />
    <ProjectReference Include="..\GameTranslator.Shell\GameTranslator.Shell.csproj" />
    <ProjectReference Include="..\GameTranslator.TvInstall\GameTranslator.TvInstall.csproj" />
  </ItemGroup>

</Project>
