<UserControl x:Class="GameTranslator.App.Views.OnboardingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GameTranslator.App.Controls"
             xmlns:t="clr-namespace:GameTranslator.App.Theme"
             Background="{DynamicResource backgroundBrush}" Foreground="{DynamicResource textPrimaryBrush}">
    <DockPanel>
        <!-- ========================================================= -->
        <!-- الترويسة العلوية: الشعار، العنوان، شارة الخطوة وزر الإغلاق -->
        <!-- ========================================================= -->
        <Border DockPanel.Dock="Top" Background="#111622" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="#0A84FF" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel>
                            <TextBlock Text="معالج إعداد GameTranslator" FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="الإعداد السريع لـ PlayStation 5 والتلفزيون الذكي" FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#1F0A84FF" CornerRadius="12" Padding="10,3" Margin="0,0,10,0">
                            <TextBlock x:Name="StepBadgeText" Text="الخطوة 1 / 5" FontWeight="Bold" FontSize="11" FontFamily="Consolas" Foreground="#38BDF8" />
                        </Border>
                        <Button Content="✕ انتقل إلى الشاشة الرئيسية" Click="OnSkipToMain" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10.5" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>

                <!-- شريط الخطوات الأربع (أزرار كبسولية) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="Pill1" Grid.Column="0" Click="OnPill1" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar1" Height="4" CornerRadius="2" Background="#0A84FF" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText1" Text="1. البداية" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill2" Grid.Column="2" Click="OnPill2" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar2" Height="4" CornerRadius="2" Background="#232B3E" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText2" Text="2. جهاز PS5" FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill3" Grid.Column="4" Click="OnPill3" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar3" Height="4" CornerRadius="2" Background="#232B3E" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText3" Text="3. التلفزيون الذكي" FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="Pill4" Grid.Column="6" Click="OnPill4" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <StackPanel>
                            <Border x:Name="PillBar4" Height="4" CornerRadius="2" Background="#232B3E" Margin="0,0,0,4" />
                            <TextBlock x:Name="PillText4" Text="4. الاختبار والبدء" FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- الشريط السفلي: رجوع، انتقل إلى الشاشة الرئيسية، متابعة    -->
        <!-- ========================================================= -->
        <Border DockPanel.Dock="Bottom" Background="#111622" BorderBrush="{DynamicResource borderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Button x:Name="BackButton" Content="← رجوع" Click="OnBack" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" MinWidth="90" MinHeight="34" />
                <Button Content="انتقل إلى الشاشة الرئيسية (تخطٍّ)" Click="OnSkipToMain" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" MinHeight="34" Padding="14,0" />
                <Button x:Name="NextButton" Content="متابعة ➔" Click="OnNext" Background="#0A84FF" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Right" MinWidth="110" MinHeight="34">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- ========================================================= -->
        <!-- محتويات الخطوات                                           -->
        <!-- ========================================================= -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0B0E14" Padding="28,20">
            <StackPanel MaxWidth="680" HorizontalAlignment="Center">
                <!-- ==================== الخطوة 1: البداية ==================== -->
                <StackPanel x:Name="Step1Panel" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#1F0A84FF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="✨" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="مرحبًا بك في GameTranslator" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="يقرأ الترجمة الإنجليزية في ألعاب PS5 من الشاشة ويعرضها فورًا بالعربية على تلفزيونك." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="3 أشياء تحتاجها للإعداد:" FontWeight="Bold" FontSize="12.5" Foreground="{DynamicResource textPrimaryBrush}" Margin="0,0,0,10" />

                    <!-- المتطلّب 1 -->
                    <Border Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.Controller}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="جهاز PlayStation 5" FontWeight="SemiBold" FontSize="12.5" Foreground="White" />
                                <TextBlock Text="يجب أن يكون مشغّلًا وعلى شبكة Wi-Fi أو Ethernet المحلية نفسها مع هذا الكمبيوتر." FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- المتطلّب 2 -->
                    <Border Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.Tv}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="تلفزيون ذكي أو شاشة" FontWeight="SemiBold" FontSize="12.5" Foreground="White" />
                                <TextBlock Text="LG webOS أو Samsung Tizen أو Android TV، أو العرض مباشرة على الشاشة عبر OBS." FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- المتطلّب 3 -->
                    <Border Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Static c:Glyphs.People}" Style="{StaticResource GlyphText}" FontSize="18" Foreground="#38BDF8" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="حساب PSN مجاني ثانٍ" FontWeight="SemiBold" FontSize="12.5" Foreground="White" />
                                <TextBlock Text="حساب جانبي يتصل به الكمبيوتر حتى لا يفصل Remote Play ذراع التحكم عن التلفزيون." FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- ==================== الخطوة 2: جهاز PS5 والاقتران ==================== -->
                <StackPanel x:Name="Step2Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#1F0A84FF" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="اقتران جهاز PlayStation 5 (مرة واحدة)" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="لنقل صورة PS5 إلى الكمبيوتر اربط حساب PSN واقرن Chiaki." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- المرحلة 1: تسجيل الدخول إلى حساب PSN (للرمز الذي يطلبه Chiaki) -->
                    <Border Background="#161B26" BorderBrush="#0A84FF" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="🔑" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="المرحلة 1: ربط حساب PSN (رمز حساب Chiaki)" FontWeight="Bold" FontSize="13.5" Foreground="#38BDF8" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="يطلب محرك Chiaki معرّف حساب PSN عند الاتصال بجهاز PS5 حفاظًا على أمانك. اربط حسابك بتسجيل الدخول أدناه أو برمز خارجي:" FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" LineHeight="16" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PsnSignInButton" Content="🌐 سجّل الدخول بحساب PSN" Click="OnOpenSonyLogin" Style="{StaticResource SecondaryButton}" Padding="14,6" FontSize="11.5" />
                                <TextBlock Grid.Column="1" x:Name="PsnStatusText" Text="إذا سجّلت الدخول يمكنك الاقتران مباشرة برمز PIN." FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" />
                            </Grid>

                            <!-- بطاقة عرض معرّف حساب PSN ونسخه -->
                            <Border x:Name="PsnIdCard" Background="#0E121B" BorderBrush="#10B981" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,4,0,8" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="✓ تم ربط حساب PSN! الرمز المطلوب لـ Chiaki:" FontWeight="Bold" FontSize="11" Foreground="#10B981" Margin="0,0,0,4" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PsnIdDisplay" IsReadOnly="True" Text="" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Background="#161B26" Foreground="#38BDF8" VerticalContentAlignment="Center" Padding="8,4" />
                                        <Button Grid.Column="1" Content="📋 انسخ الرمز" Click="OnCopyPsnId" Background="#10B981" Foreground="White" FontWeight="Bold" Padding="14,4" Margin="8,0,0,0" Cursor="Hand" />
                                    </Grid>
                                    <TextBlock Text="💡 ستلصق هذا الرمز في خانة 'PSN Account-ID' عند تسجيل جهاز الألعاب في Chiaki." FontSize="10" Foreground="#94A3B8" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- إدخال بديل للرمز / Token -->
                            <Border Background="#0E121B" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="بديل: الصق رمز الدخول من متصفح خارجي" FontSize="10.5" FontWeight="SemiBold" Foreground="#94A3B8" VerticalAlignment="Center" />
                                        <Button Content="🌐 افتح صفحة دخول Sony" Click="OnOpenExternalSonyBrowser" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="10" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PsnCodeInput" MinHeight="28" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="10" Margin="0,0,6,0" ToolTip="الصق رابط إعادة التوجيه أو قيمة code=..." />
                                        <Button x:Name="PsnVerifyButton" Grid.Column="1" Content="تحقّق" Click="OnVerifyPsnCode" Style="{StaticResource SecondaryButton}" Padding="12,2" FontSize="10" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- المرحلة 2: اقتران جهاز الألعاب عبر Chiaki -->
                    <Border Background="#161B26" BorderBrush="#232B3E" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="📺" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="المرحلة 2: اقتران جهاز الألعاب عبر Chiaki (10 ثوانٍ)" FontWeight="Bold" FontSize="13.5" Foreground="White" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- تعليمات خطوة بخطوة -->
                            <Border Background="#0E121B" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="1." FontWeight="Bold" FontSize="11" Foreground="#0A84FF" />
                                        <TextBlock Grid.Column="1" Text="على PS5 وأنت بالمستخدم الثاني، انتقل إلى الإعدادات › النظام › Remote Play. فعّل Enable Remote Play واختر Pair Device (سيظهر رمز PIN من 8 أرقام على شاشة التلفزيون)." FontSize="10.5" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="15" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="2." FontWeight="Bold" FontSize="11" Foreground="#0A84FF" />
                                        <TextBlock Grid.Column="1" Text="اضغط الزر «📺 افتح واجهة Chiaki واقرن PS5» أدناه." FontSize="10.5" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="15" />
                                    </Grid>

                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="3." FontWeight="Bold" FontSize="11" Foreground="#0A84FF" />
                                        <TextBlock Grid.Column="1" Text="في نافذة Chiaki التي تفتح، انقر نقرًا مزدوجًا على جهاز PS5 في القائمة (أو انقر بالزر الأيمن واختر Register)؛ ثم اكتب رمز PIN من 8 أرقام الظاهر على التلفزيون ومعرّف حساب PSN أعلاه لإتمام الاقتران." FontSize="10.5" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="15" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" FontWeight="Bold" FontSize="12" Foreground="#10B981" />
                                        <TextBlock Grid.Column="1" Text="اكتمل الاقتران! أغلق Chiaki واضغط زر «متابعة ➔» في أسفل اليمين للانتقال إلى خطوة التلفزيون." FontSize="10.5" Foreground="#10B981" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="15" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- زر كبير لافت -->
                            <Button x:Name="BtnOpenChiakiGui" Click="OnOpenChiakiPairingGui" Background="#0A84FF" Foreground="White" FontWeight="Bold" BorderThickness="0" MinHeight="44" FontSize="13" Cursor="Hand" Margin="0,0,0,6">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="6" />
                                    </Style>
                                </Button.Resources>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="📺" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="افتح واجهة Chiaki واقرن PS5 ➔" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock x:Name="PairStatusText" Margin="0,4,0,0" FontSize="11" Foreground="#10B981" TextWrapping="Wrap" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- خيارات متقدمة / بديلة (Expander مخفي / اختياري) -->
                    <Border Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Expander Header="⚙️ متقدم: اقرن يدويًا بعنوان IP ورمز PIN" Background="Transparent" Foreground="{DynamicResource textSecondaryBrush}" FontSize="11" BorderThickness="0">
                            <StackPanel Margin="0,10,0,0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="عنوان IP لجهاز PS5:" FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" VerticalAlignment="Center" />
                                    <Button Content="🔍 ابحث في الشبكة" Click="OnScanPs5" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Padding="6,2" FontSize="10" />
                                </Grid>
                                <TextBox x:Name="Ps5HostInput" Text="192.168.1.109" MinHeight="30" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="11" Margin="0,0,0,8" />

                                <TextBlock Text="رمز PIN للاقتران (8 أرقام):" FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,4" />
                                <TextBox x:Name="Ps5PinInput" Text="" MinHeight="32" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="14" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,8" />
                                <Button x:Name="PairButton" Content="اقرن يدويًا" Click="OnPairPs5" Style="{StaticResource SecondaryButton}" MinHeight="32" FontSize="11" />
                            </StackPanel>
                        </Expander>
                    </Border>
                </StackPanel>

                <!-- ==================== الخطوة 3: التلفزيون الذكي ==================== -->
                <StackPanel x:Name="Step3Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#1F10B981" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="📺" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="أين تُعرض الترجمة؟" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="اختر تلفزيونك، أو اختر شاشة الكمبيوتر مباشرة إن لم يكن لديك تلفزيون." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- بطاقات اختيار المنصة (أزرار قابلة للنقر) -->
                    <StackPanel Margin="0,0,0,14">
                        <!-- 1. PC & OBS -->
                        <Button Click="OnSelectTvPc" Background="Transparent" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Border x:Name="TvBorderPc" Background="#161B26" BorderBrush="#0A84FF" BorderThickness="2" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🖥️" FontSize="16" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="شاشة الكمبيوتر و OBS Overlay (لا حاجة إلى تلفزيون)" FontWeight="Bold" FontSize="12" Foreground="White" />
                                        <TextBlock Text="لمن يلعب على شاشة الكمبيوتر: يعرض الترجمة مباشرة على الشاشة أو في بث OBS المباشر." FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgePc" Grid.Column="2" Background="#1F10B981" CornerRadius="10" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="محدّد" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 2. Samsung Smart TV -->
                        <Button Click="OnSelectTvSamsung" Background="Transparent" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Border x:Name="TvBorderSamsung" Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="16" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Samsung Smart TV (Tizen)" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                        <TextBlock Text="عرض الترجمة على تلفزيونات Samsung عبر حزمة WGT (موديلات 2018 وما بعدها)." FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeSamsung" Grid.Column="2" Background="#1F10B981" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="محدّد" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 3. LG webOS TV -->
                        <Button Click="OnSelectTvLg" Background="Transparent" BorderThickness="0" Margin="0,0,0,8" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Border x:Name="TvBorderLg" Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="📺" FontSize="16" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="LG webOS TV (OLED / QNED)" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                        <TextBlock Text="اتصال مباشر بتلفزيونات LG webOS عبر حزمة IPK أو وضع المطوّر." FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeLg" Grid.Column="2" Background="#1F10B981" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="محدّد" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>

                        <!-- 4. Android TV / Google TV -->
                        <Button Click="OnSelectTvAndroid" Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <Border x:Name="TvBorderAndroid" Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🤖" FontSize="16" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Android TV / Google TV" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                                        <TextBlock Text="الاتصال بأجهزة TCL و Philips و Xiaomi و Google TV Box عبر تطبيق APK." FontSize="10.5" Foreground="{DynamicResource textSecondaryBrush}" />
                                    </StackPanel>
                                    <Border x:Name="TvBadgeAndroid" Grid.Column="2" Background="#1F10B981" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Visibility="Collapsed">
                                        <TextBlock Text="محدّد" FontSize="9.5" FontWeight="Bold" Foreground="#10B981" />
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                    </StackPanel>

                    <!-- لوحة تفاصيل المنصة المحدّدة -->
                    <Border Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <!-- Panel: PC / OBS -->
                            <StackPanel x:Name="TvDetailPc" Visibility="Visible">
                                <TextBlock Text="تم اختيار شاشة الكمبيوتر و OBS Overlay" FontWeight="Bold" FontSize="12" Foreground="#10B981" Margin="0,0,0,4" />
                                <TextBlock Text="لا حاجة إلى إعداد تلفزيون خارجي. تُعرض الترجمة مباشرة على شاشة هذا الكمبيوتر وعلى رابط OBS التالي:" FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <TextBlock Text="http://localhost:8787/obs" FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center" />
                                    <Button Content="انسخ رابط OBS" HorizontalAlignment="Right" Click="OnCopyObsUrl" Style="{StaticResource SecondaryButton}" Padding="10,3" FontSize="10.5" />
                                </Grid>
                            </StackPanel>

                            <!-- Panel: Samsung Tizen TV -->
                            <StackPanel x:Name="TvDetailSamsung" Visibility="Collapsed">
                                <TextBlock Text="إعداد Samsung Smart TV (Tizen)" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock Text="أدخل عنوان IP لتلفزيون Samsung وافتح تطبيق GameTranslator المثبّت على التلفزيون:" FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SamsungHostInput" Text="192.168.1.108" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="11.5" />
                                    <Button Grid.Column="1" Content="احفظ تلفزيون Samsung" Click="OnSaveSamsung" Background="#0A84FF" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="12,4" />
                                </Grid>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁 أظهر ملف Samsung WGT" Click="OnOpenSamsungWgt" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10.5" Margin="0,0,8,0" />
                                    <Button Content="📖 دليل إعداد التلفزيون (PDF)" Click="OnOpenGuidePdf" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10.5" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Panel: LG webOS TV -->
                            <StackPanel x:Name="TvDetailLg" Visibility="Collapsed">
                                <TextBlock Text="إعداد LG webOS TV" FontWeight="Bold" FontSize="12" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock Text="أدخل عنوان IP لتلفزيون LG. عند الضغط على «اتصل» قد يظهر طلب تأكيد على شاشة التلفزيون؛ اقبله بالريموت:" FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="LgHostInput" Text="192.168.1.108" MinHeight="32" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="11.5" />
                                    <Button Grid.Column="1" Content="اتصل بتلفزيون LG" Click="OnSaveLg" Background="#0A84FF" Foreground="White" FontWeight="Bold" BorderThickness="0" Padding="12,4" />
                                </Grid>
                                <Button Content="📁 أظهر ملف LG IPK" Click="OnOpenLgIpk" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Padding="10,4" FontSize="10.5" />
                            </StackPanel>

                            <!-- Panel: Android TV -->
                            <StackPanel x:Name="TvDetailAndroid" Visibility="Collapsed">
                                <TextBlock Text="إعداد Android TV / Google TV" FontWeight="Bold" FontSize="12.5" Foreground="#38BDF8" Margin="0,0,0,4" />
                                <TextBlock Text="أدخل عنوان IP لجهاز Android TV ثم انقر الزر أدناه لتثبيت التطبيق على التلفزيون وفتحه بنقرة واحدة:" FontSize="11" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap" />

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="AndroidHostInput" Text="192.168.1.108" MinHeight="34" VerticalContentAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas" FontSize="12" />
                                    <Button x:Name="ScanAndroidTvButton" Grid.Column="1" Content="🔍 ابحث عن التلفزيون" Click="OnScanAndroidTv" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" Margin="0,0,8,0" />
                                    <Button Grid.Column="2" Content="احفظ عنوان IP فقط" Click="OnSaveAndroid" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="11" />
                                </Grid>

                                <!-- زر التثبيت عبر ADB بنقرة واحدة -->
                                <Button x:Name="AndroidInstallButton" Content="🚀 ثبّت التطبيق على التلفزيون وشغّله (ADB بنقرة واحدة)" Click="OnInstallAndroidApp" Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" MinHeight="38" FontSize="12.5" Cursor="Hand" Margin="0,0,0,8">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="6" />
                                        </Style>
                                    </Button.Resources>
                                </Button>

                                <!-- لوحة حالة ADB والإرشادات -->
                                <Border Background="#0E121B" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="💡 معلومات تثبيت Android TV:" FontWeight="SemiBold" FontSize="10.5" Foreground="#38BDF8" Margin="0,0,0,3" />
                                        <TextBlock Text="• على التلفزيون افتح Settings › Device Preferences › About واضغط على Build 7 مرات لتفعيل Developer options." FontSize="10" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,2" />
                                        <TextBlock Text="• من Developer options فعّل USB debugging / Network debugging (ADB)." FontSize="10" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,4" />
                                        <TextBlock x:Name="AndroidInstallStatus" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="📁 أظهر ملف Android APK" Click="OnOpenAndroidApk" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10.5" Margin="0,0,8,0" />
                                    <Button Content="📖 دليل إعداد التلفزيون (PDF)" Click="OnOpenGuidePdf" Style="{StaticResource SecondaryButton}" Padding="10,4" FontSize="10.5" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock x:Name="TvStatusFeedback" Margin="0,8,0,0" FontSize="11" Foreground="#10B981" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ==================== الخطوة 4: الاختبار والانتهاء ==================== -->
                <StackPanel x:Name="Step4Panel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Width="44" Height="44" CornerRadius="22" Background="#1F10B981" Margin="0,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="🎉" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="تهانينا، اكتمل الإعداد!" FontWeight="Bold" FontSize="18" Foreground="{DynamicResource textPrimaryBrush}" />
                            <TextBlock Text="أنت الآن جاهز للعب ألعاب PS5 على تلفزيونك مع ترجمة عربية مباشرة." FontSize="12" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Background="#161B26" BorderBrush="#232B3E" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="كيف تلعب؟" FontWeight="Bold" FontSize="13" Foreground="White" Margin="0,0,0,10" />
                            <TextBlock Text="1. انتقل على التلفزيون إلى مدخل HDMI الخاص بـ PS5 وأمسك ذراع التحكم DualSense." FontSize="11.5" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="2. على الكمبيوتر اضغط زر «▶ ابدأ الترجمة» في الشاشة الرئيسية." FontSize="11.5" Foreground="{DynamicResource textSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBlock Text="3. تظهر ترجمة اللعبة فورًا بالعربية على شاشة التلفزيون!" FontSize="11.5" Foreground="#10B981" FontWeight="SemiBold" />
                        </StackPanel>
                    </Border>

                    <Button Content="📺 أرسل سطر ترجمة تجريبيًا إلى التلفزيون" Click="OnTestTv" Style="{StaticResource SecondaryButton}" MinHeight="36" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Button Content="▶ انتقل إلى الشاشة الرئيسية وابدأ الترجمة" Click="OnSkipToMain" Background="#0A84FF" Foreground="White" FontWeight="Bold" FontSize="13" BorderThickness="0" MinHeight="42" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="8" />
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
