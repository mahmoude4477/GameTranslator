<UserControl x:Class="GameTranslator.App.Views.Steps.TestStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GameTranslator.App.Controls"
             xmlns:t="clr-namespace:GameTranslator.App.Theme">
    <c:StepLayout Glyph="{x:Static c:Glyphs.Seal}" Title="{t:T 'Let\'s test it'}"
                  Message="{t:T 'GameTranslator will send a sample subtitle to your TV. It should appear at the bottom of the screen, on top of the game.'}">
        <StackPanel>
            <Button x:Name="Send" Content="{t:T 'Send test subtitle'}" Style="{StaticResource PrimaryButton}" Click="OnSend" />
            <c:Card x:Name="Question" Title="{t:T 'Do you see it on the TV?'}" Margin="0,20,0,0" Visibility="Collapsed">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="{t:T 'Yes, I see it'}" Style="{StaticResource PrimaryButton}" Click="OnYes" IsDefault="True" />
                        <Button Content="{t:T 'No'}" Margin="12,0,0,0" Click="OnNo" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,12,0,0"
                               Text="{t:T 'If you don\'t see it, make sure the GameTranslator TV app is open and connect the TV again.'}" />
                </StackPanel>
            </c:Card>
        </StackPanel>
    </c:StepLayout>
</UserControl>
