<UserControl x:Class="GameTranslator.App.Views.Steps.TvStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GameTranslator.App.Controls"
             xmlns:s="clr-namespace:GameTranslator.App.Views.Steps"
             xmlns:t="clr-namespace:GameTranslator.App.Theme">
    <c:StepLayout Glyph="{x:Static c:Glyphs.Tv}" Title="{t:T 'Connect your TV'}"
                  Message="{t:T 'Turn on the TV. When you press Connect, the TV asks for permission once — accept it with the remote. If the GameTranslator TV app is missing, this screen helps you install it.'}">
        <StackPanel>
            <TextBlock x:Name="Done" Style="{StaticResource DoneText}" Margin="0,0,0,16" />
            <c:Card>
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <TextBlock Text="TV" Style="{StaticResource HeadlineText}" VerticalAlignment="Center" />
                        <Button x:Name="Search" Content="{t:T 'Search again'}" HorizontalAlignment="Right" Click="OnSearch" />
                    </Grid>
                    <TextBlock x:Name="NotFound" Style="{StaticResource HintText}" Text="{t:T 'No LG or Samsung TV found. Make sure the TV is on and on the same network.'}" />
                    <StackPanel x:Name="Tvs" />
                </StackPanel>
            </c:Card>
            <c:Card Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Android TV / Google TV" VerticalAlignment="Center" />
                        <Button Content="{t:T 'Select'}" HorizontalAlignment="Right" Click="OnAndroidTv" />
                    </Grid>
                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                               Text="{t:T 'Vestel, Arçelik, Beko, Grundig, Philips and other TVs running Android TV.'}" />
                </StackPanel>
            </c:Card>
            <TextBlock x:Name="Waiting" Style="{StaticResource HintText}" Margin="0,16,0,0" Visibility="Collapsed"
                       Text="{t:T 'Accept the request on the TV…'}" />
            <TextBlock Style="{StaticResource HintText}" Margin="0,16,0,0"
                       Text="{t:T 'If Windows asks whether GameTranslator may use the network, allow it for private networks.'}" />
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
            <s:TvAppCard Margin="0,16,0,0" />
            <c:Card x:Name="ManualInstall" Title="{t:T 'GameTranslator TV app'}" Margin="0,16,0,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock TextWrapping="Wrap" Text="{t:T 'Install the GameTranslator TV app on this TV using the guide and open it. It finds this computer by itself.'}" />
                    <Button Content="{t:T 'Open the guide'}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnGuide" />
                </StackPanel>
            </c:Card>
        </StackPanel>
    </c:StepLayout>
</UserControl>
