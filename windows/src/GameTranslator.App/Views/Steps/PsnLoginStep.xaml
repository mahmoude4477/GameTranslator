<UserControl x:Class="GameTranslator.App.Views.Steps.PsnLoginStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:GameTranslator.App.Controls"
             xmlns:t="clr-namespace:GameTranslator.App.Theme">
    <c:StepLayout Glyph="{x:Static c:Glyphs.Person}" Title="{t:T 'Sign in with the second account'}"
                  Message="{t:T 'Sign in to PlayStation Network with the second account you just created. Your password goes directly to Sony; GameTranslator only keeps the account ID.'}">
        <StackPanel>
            <TextBlock Text="{t:T 'Signed in'}" Style="{StaticResource DoneText}" Margin="0,0,0,12"
                       Visibility="{Binding HasAccount, Converter={StaticResource VisibleIf}}" />
            <Button x:Name="SignIn" Click="OnSignIn" />
            <TextBlock x:Name="Error" Style="{StaticResource ErrorText}" Margin="0,12,0,0" />
        </StackPanel>
    </c:StepLayout>
</UserControl>
