<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!-- Mac uygulamasının içine gömülen tek dosyalık yardımcı (scripts/build-tv-helper.sh). Native AOT: tek imzalı
       dosya, JIT gerekmez; böylece Apple onaylı uygulamanın içinde ek yetki istemeden çalışır. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gametranslator-tv-helper</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <!-- XML imzası (System.Security.Cryptography.Xml) yansımayla tür oluşturur; o derlemeler kırpılmasın. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="System.Security.Cryptography.Xml" />
    <TrimmerRootAssembly Include="TizenSdb.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameTranslator.TvInstall\GameTranslator.TvInstall.csproj" />
  </ItemGroup>

</Project>
