<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!-- أداة مساعدة من ملف واحد تُضمَّن داخل تطبيق Mac (scripts/build-tv-helper.sh). Native AOT: ملف واحد
       موقَّع ولا حاجة إلى JIT؛ فتعمل داخل التطبيق المعتمد من Apple دون طلب صلاحيات إضافية. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>gametranslator-tv-helper</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <PublishAot>true</PublishAot>
    <!-- توقيع XML (System.Security.Cryptography.Xml) ينشئ الأنواع بالانعكاس؛ فلا تُقتطع تلك التجميعات. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <TrimmerRootAssembly Include="System.Security.Cryptography.Xml" />
    <TrimmerRootAssembly Include="TizenSdb.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GameTranslator.TvInstall\GameTranslator.TvInstall.csproj" />
  </ItemGroup>

</Project>
