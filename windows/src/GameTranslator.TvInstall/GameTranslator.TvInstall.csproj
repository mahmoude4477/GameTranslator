<Project Sdk="Microsoft.NET.Sdk">
  <!-- SPDX-License-Identifier: AGPL-3.0-only -->
  <!-- يثبّت تطبيق GameTranslator للتلفزيون على Samsung و Android TV عبر الشبكة. تطبيق Windows يستخدمه مباشرة،
       وتطبيق Mac عبر GameTranslator.TvHelper. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TizenSdb.Core" Version="1.1.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- الشهادات الوسيطة التي تصدر شهادات المطوّرين لدى Samsung (من Tizen Studio، دون تعديل). -->
    <EmbeddedResource Include="Samsung\ca\*.pem" LogicalName="SamsungCa.%(Filename).pem" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="GameTranslator.TvInstall.Tests" />
  </ItemGroup>

</Project>
